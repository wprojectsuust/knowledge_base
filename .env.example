# LLM (Gemini через OpenAI-совместимый эндпоинт)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Опционально: SOCKS5/HTTP прокси до Gemini API, если нет прямого доступа
PROXY_URL=

# PostgreSQL (хранилище документов, доступ через asyncpg)
POSTGRES_USER=uunit
POSTGRES_PASSWORD=uunit
POSTGRES_DB=uunit
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ChromaDB (локальный персистентный клиент, путь внутри контейнера)
CHROMA_PATH=/data/chroma_db
