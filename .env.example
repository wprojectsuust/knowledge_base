# LLM - любой OpenAI-совместимый API. Если LLM_* пусты, используется Gemini (GEMINI_* ниже)
LLM_BASE_URL=https://api.claudehub.fun/v1
LLM_API_KEY=
LLM_MODEL=Qwen-3.8-Max
# Gemini (запасной вариант)
GEMINI_API_KEY=
# Можно несколько через запятую: если первая перегружена (503), запрос уходит на следующую
GEMINI_MODEL=gemini-3.6-flash,gemini-2.5-flash,gemini-flash-latest,gemini-3.1-flash-lite
# Сколько секунд модель «остывает» после 429 (лимит запросов) - пока остывает, идём на запасную
LLM_RATE_LIMIT_COOLDOWN_SECONDS=60
# Опционально: SOCKS5/HTTP прокси до Gemini API, если нет прямого доступа
PROXY_URL=

# PostgreSQL (хранилище документов, доступ через asyncpg)
POSTGRES_USER=uunit
POSTGRES_PASSWORD=uunit
POSTGRES_DB=uunit
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ChromaDB (локальный персистентный клиент, путь внутри контейнера)
CHROMA_PATH=/data/chroma_db

# Импорт новостей uust.ru в базу знаний: раз в N минут (0 - только вручную, POST /news/import)
# и сколько свежих новостей проверять за раз
NEWS_IMPORT_INTERVAL_MINUTES=180
NEWS_IMPORT_LIMIT=14
# Пауза между новостями при импорте (сек) - чтобы фон не выедал лимит запросов к Gemini
NEWS_IMPORT_PAUSE_SECONDS=20
# список документов uust.ru/sveden/document/ (названия + ссылки): раз в N часов, 0 - выкл
DOCUMENTS_IMPORT_INTERVAL_HOURS=24
# Уровень логирования (DEBUG - подробные логи по умолчанию: запросы к API, БД, ИИ, что нашлось)
LOG_LEVEL=DEBUG

# Откуда разрешены запросы к backend-у (CORS): * - откуда угодно, или адреса через запятую
FRONTEND_ORIGIN=*
