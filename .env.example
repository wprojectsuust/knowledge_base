# LLM (Gemini через OpenAI-совместимый эндпоинт)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Опционально: SOCKS5/HTTP прокси до Gemini API, если нет прямого доступа
PROXY_URL=

# MinIO (S3-совместимое хранилище данных)
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=uunit-data

# ChromaDB (локальный персистентный клиент, путь внутри контейнера)
CHROMA_PATH=/data/chroma_db
